# Backend — Sistema de Pedidos Anticipados (Cafetería ITSH)
#
# Copia este archivo a `.env` y ajusta los valores. El archivo `.env` NO se versiona.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# URL de conexión a MySQL 8.0+ (usuario cafe_admin / base cafe_itsh)
DATABASE_URL=mysql://cafe_admin:cafeContra@127.0.0.1:3306/cafe_itsh

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia del token de sesión
JWT_EXPIRES_IN=2h

# Origen permitido para CORS (el servidor de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Ventana de pedido anticipado (formato HH:MM, 24h) y anticipación mínima en minutos.
# Fuera de la ventana (o con menos anticipación que el mínimo) se rechaza el pedido con 422.
PEDIDO_VENTANA_INICIO=07:00
PEDIDO_VENTANA_FIN=14:00
PEDIDO_ANTICIPACION_MIN=10
